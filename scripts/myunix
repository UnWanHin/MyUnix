#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/scripts/lib/core.sh"
source "$ROOT/scripts/lib/manifest.sh"
source "$ROOT/scripts/lib/state.sh"
source "$ROOT/scripts/lib/ui.sh"
source "$ROOT/scripts/lib/network.sh"
source "$ROOT/modules/bootstrap/install.sh"
source "$ROOT/modules/dnf/install.sh"
source "$ROOT/modules/dnf/export.sh"
source "$ROOT/modules/time-sync/install.sh"
source "$ROOT/modules/rpm/install.sh"
source "$ROOT/modules/gnome/install.sh"
source "$ROOT/modules/gnome/export.sh"
source "$ROOT/modules/input-method/install.sh"
source "$ROOT/modules/input-method/export.sh"
source "$ROOT/modules/niri-dms/install.sh"
source "$ROOT/modules/niri-dms/export.sh"
source "$ROOT/modules/niri-dms-greeter/install.sh"
source "$ROOT/modules/niri-dms-greeter/rollback.sh"
source "$ROOT/modules/shell-config/install.sh"
source "$ROOT/modules/shell-config/export.sh"
source "$ROOT/modules/phone-connect/install.sh"
source "$ROOT/modules/phone-connect/export.sh"
source "$ROOT/modules/portal-login/install.sh"
source "$ROOT/modules/steam/install.sh"
source "$ROOT/modules/development-toolchain/install.sh"
source "$ROOT/modules/distrobox/install.sh"
source "$ROOT/modules/distrobox-ros2-humble/install.sh"
source "$ROOT/modules/distrobox-codex/install.sh"
source "$ROOT/modules/codex-super-bullet/install.sh"

run_doctor() {
  local manifest
  is_fedora || die 'Fedora is required'
  require_command dnf
  require_command dconf
  for manifest in \
    "$ROOT/modules/dnf/core.txt" \
    "$ROOT/modules/dnf/optional.txt" \
    "$ROOT/modules/input-method/packages.txt" \
    "$ROOT/modules/phone-connect/packages.txt" \
    "$ROOT/modules/portal-login/packages.txt" \
    "$ROOT/modules/time-sync/packages.txt" \
    "$ROOT/modules/development-toolchain/packages.txt" \
    "$ROOT/modules/distrobox/packages.txt"; do
    verify_dnf_manifest_available "$manifest" || die "DNF manifest contains unavailable packages: $manifest"
  done
  info 'Fedora GNOME prerequisites verified'
}

install_rpm_manifest() {
  local mode=$1 manifest="$ROOT/modules/rpm/apps.tsv"
  local id name url sha selection verify_command verify_argument
  validate_rpm_manifest "$manifest" || die "Invalid RPM manifest: $manifest"
  while IFS='|' read -r id name url sha selection verify_command verify_argument; do
    is_comment_or_blank "$id" && continue
    [[ "$selection" == default || "$mode" == guided ]] || continue
    [[ "$selection" == default ]] || prompt_optional_app "$id" "$name" || { info "Skip $name"; continue; }
    install_rpm_record "$id" "$name" "$url" "$sha" "$selection" "$verify_command" "$verify_argument"
  done < "$manifest"
}

run_module() {
  local module=$1 status=0
  case "$module" in
    bootstrap) install_bootstrap || status=1 ;;
    dnf)
      install_dnf_manifest "$ROOT/modules/dnf/core.txt" || status=1
      if ((status == 0)) && [[ "${MYUNIX_INSTALL_MODE:-all}" == guided ]]; then
        install_optional_dnf_manifest "$ROOT/modules/dnf/optional.txt" || status=1
      fi
      ;;
    time-sync) install_time_sync || status=1 ;;
    rpm) install_rpm_manifest "${MYUNIX_INSTALL_MODE:-all}" || status=1 ;;
    gnome) import_gnome || status=1 ;;
    input-method) install_input_methods "${MYUNIX_INPUT_CANGJIE:-1}" "${MYUNIX_INPUT_PINYIN:-1}" || status=1 ;;
    niri-dms) install_niri_dms || status=1 ;;
    niri-dms-greeter) install_niri_dms_greeter || status=1 ;;
    shell-config) install_shell_config || status=1 ;;
    phone-connect) install_phone_connect || status=1 ;;
    portal-login) install_portal_login || status=1 ;;
    steam) install_steam || status=1 ;;
    development-toolchain) install_development_toolchain || status=1 ;;
    distrobox) install_distrobox || status=1 ;;
    distrobox-ros2-humble) install_distrobox_ros2_humble || status=1 ;;
    distrobox-codex) install_distrobox_codex || status=1 ;;
    codex-super-bullet) install_codex_super_bullet || status=1 ;;
    *) die "Unknown module: $module" ;;
  esac
  if ((status == 0)); then
    state_mark "module:$module" succeeded
  else
    state_mark "module:$module" failed
    status=1
  fi
  return "$status"
}

print_module_summary() {
  local outcomes_name=$1 module status
  shift
  local -n outcomes_ref="$outcomes_name"
  local succeeded=0 skipped=0 failed=0 deferred=0
  for module in "$@"; do
    status="${outcomes_ref[$module]:-skipped}"
    case "$status" in
      succeeded) succeeded=$((succeeded + 1)) ;;
      skipped) skipped=$((skipped + 1)) ;;
      failed) failed=$((failed + 1)) ;;
      deferred) deferred=$((deferred + 1)) ;;
    esac
    printf '  %s: %s\n' "$module" "$status"
  done
  printf 'Installation summary: succeeded=%s skipped=%s failed=%s deferred=%s\n' \
    "$succeeded" "$skipped" "$failed" "$deferred"
}

run_selected_modules() {
  local module result=0 current=0 total=$# started elapsed action
  local -A outcomes=()
  for module in "$@"; do
    current=$((current + 1))
    started=$SECONDS
    printf '[%s/%s] %s\n' "$current" "$total" "$module"
    while :; do
      if run_module "$module"; then
        elapsed=$((SECONDS - started))
        printf '[%s/%s] %s completed in %ss\n' "$current" "$total" "$module" "$elapsed"
        outcomes[$module]=succeeded
        break
      fi

      elapsed=$((SECONDS - started))
      printf '[%s/%s] %s failed after %ss\n' "$current" "$total" "$module" "$elapsed" >&2
      if ! ui_is_interactive; then
        result=1
        outcomes[$module]=failed
        printf '[%s/%s] continuing after failure\n' "$current" "$total" >&2
        break
      fi

      action="$(ui_choose_failure_action "$module")" || return 1
      case "$action" in
        retry) printf '[%s/%s] retrying %s\n' "$current" "$total" "$module" ;;
        skip)
          state_mark "module:$module" deferred
          result=1
          outcomes[$module]=deferred
          printf '[%s/%s] deferred %s; continuing\n' "$current" "$total" "$module"
          break
          ;;
        stop)
          outcomes[$module]=failed
          printf '[%s/%s] stopping at %s\n' "$current" "$total" "$module" >&2
          print_module_summary outcomes "$@"
          printf 'Installation stopped. Retry failed or deferred modules with: ./scripts/myunix retry\n' >&2
          return 1
          ;;
        *) die "Invalid failure action: $action" ;;
      esac
    done
  done
  print_module_summary outcomes "$@"
  if ((result != 0)); then
    printf 'Installation finished with failed or deferred modules. Retry them with: ./scripts/myunix retry\n' >&2
  fi
  return "$result"
}

run_all_install() {
  export MYUNIX_INSTALL_MODE=all
  export MYUNIX_INPUT_CANGJIE=1 MYUNIX_INPUT_PINYIN=1
  run_selected_modules bootstrap dnf time-sync rpm gnome input-method codex-super-bullet steam
}

choose_custom_input_methods() {
  local selections index
  selections="$(ui_choose_many 'Choose input methods' '0' 'English keyboard' 'Cangjie 5' 'Pinyin')" || return $?
  export MYUNIX_INPUT_CANGJIE=0 MYUNIX_INPUT_PINYIN=0
  while IFS= read -r index; do
    case "$index" in
      1) MYUNIX_INPUT_CANGJIE=1 ;;
      2) MYUNIX_INPUT_PINYIN=1 ;;
    esac
  done <<< "$selections"
}

choose_custom_desktop_applications() {
  local selections
  selections="$(ui_choose_many 'Optional desktop applications' '' 'Steam (RPM Fusion; Niri compatible)')" || return $?
  grep -qx '0' <<< "$selections"
}

choose_custom_development_toolchain() {
  local optional components scope_choice index
  local -a names=(build-tools jdk cmake ninja rust python anaconda node go gcc clang)
  optional="$(ui_choose_many 'Optional modules' '' 'Development toolchain')" || return $?
  grep -qx '0' <<< "$optional" || return 1

  components="$(ui_choose_many 'Development toolchain components' '' \
    'Build tools' 'JDK (Fedora latest)' 'CMake (Fedora)' 'Ninja' 'Rust / Cargo' 'Python development' \
    'Anaconda' 'Node.js' 'Go' 'GCC / G++' 'Clang / LLDB')" || return $?
  [[ -n "$components" ]] || {
    info 'No development-toolchain components selected.'
    return 1
  }
  MYUNIX_TOOLCHAIN_COMPONENTS=''
  while IFS= read -r index; do
    [[ "$index" =~ ^[0-9]+$ && "$index" -lt "${#names[@]}" ]] || die "Invalid development-toolchain selection: $index"
    MYUNIX_TOOLCHAIN_COMPONENTS+="${MYUNIX_TOOLCHAIN_COMPONENTS:+,}${names[$index]}"
  done <<< "$components"
  scope_choice="$(ui_choose_one 'Development toolchain scope' 'System: DNF + /opt for all users' 'User: portable tools under ~/.local/opt')" || return $?
  case "$scope_choice" in
    0) MYUNIX_TOOLCHAIN_SCOPE=system ;;
    1) MYUNIX_TOOLCHAIN_SCOPE=user ;;
    *) die "Invalid development-toolchain scope selection: $scope_choice" ;;
  esac
  export MYUNIX_TOOLCHAIN_COMPONENTS MYUNIX_TOOLCHAIN_SCOPE
}

choose_custom_niri_dms() {
  local desktop personalization
  desktop="$(ui_choose_many 'Optional desktop modules' '' 'Niri + DMS (keeps GNOME installed)')" || return $?
  grep -qx '0' <<< "$desktop" || return 1

  personalization="$(ui_choose_many 'Niri + DMS personalization' '' 'Touchpad toggle shortcut (Mod+F8)')" || return $?
  if grep -qx '0' <<< "$personalization"; then
    export MYUNIX_NIRI_DMS_TOUCHPAD_TOGGLE=1
  else
    export MYUNIX_NIRI_DMS_TOUCHPAD_TOGGLE=0
  fi
}

run_custom_install() {
  local install_niri_dms=0 install_steam=0 install_toolchain=0
  export MYUNIX_INSTALL_MODE=custom
  choose_custom_input_methods
  choose_custom_desktop_applications && install_steam=1 || true
  choose_custom_niri_dms && install_niri_dms=1 || true
  choose_custom_development_toolchain && install_toolchain=1 || true
  run_selected_modules bootstrap dnf time-sync rpm gnome input-method codex-super-bullet
  ((install_steam == 0)) || run_selected_modules steam
  ((install_niri_dms == 0)) || run_selected_modules niri-dms
  ((install_toolchain == 0)) || run_selected_modules development-toolchain
}

run_export() {
  is_fedora || die 'Fedora is required'
  export_gnome
  export_input_methods
  export_niri_dms
  export_shell_config
  export_phone_connect
  export_userinstalled_dnf_candidates
}

run_retry() {
  local item module result=0
  while IFS= read -r item; do
    module="${item#module:}"
    [[ "$module" == "$item" ]] && continue
    run_module "$module" || result=1
  done < <(state_failed_items)
  return "$result"
}

run_interactive_install() {
  local choice
  choice="$(ui_choose_one 'MyUnix installation' 'One-click installation' 'Custom installation')" || return $?
  case "$choice" in
    0) run_all_install ;;
    1) run_custom_install ;;
    *) die 'Invalid installer selection' ;;
  esac
}

run_install() {
  is_fedora || die 'Fedora is required'
  case "${1:-}" in
    --all) run_all_install ;;
    --guided) ui_require_interactive && run_custom_install ;;
    --module) [[ -n "${2:-}" ]] || die '--module requires a module name'; run_module "$2" ;;
    '') [[ -t 0 ]] || die 'Use --all, --guided, or --module outside an interactive terminal'; run_interactive_install ;;
    *) die "Unknown install option: $1" ;;
  esac
}

if [[ "${MYUNIX_SOURCE_ONLY:-}" == 1 ]]; then
  [[ "${BASH_SOURCE[0]}" != "$0" ]] && return 0
  exit 0
fi

case "${1:-}" in
  doctor) run_doctor ;;
  install) shift; run_install "$@" ;;
  export) run_export ;;
  retry) run_retry ;;
  rollback) [[ "${2:-}" == niri-dms-greeter && -n "${3:-}" ]] || die 'Usage: myunix rollback niri-dms-greeter <backup-path>'; rollback_niri_dms_greeter "$3" ;;
  *) die 'Usage: myunix {doctor|install|export|retry|rollback}' ;;
esac
