#!/usr/bin/env bash
set -Eeuo pipefail

state_file="${MYUNIX_NIRI_TOUCHPAD_STATE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/niri/myunix/touchpad.kdl}"
lock_file="${MYUNIX_NIRI_TOUCHPAD_LOCK_FILE:-${XDG_STATE_HOME:-$HOME/.local/state}/myunix/niri-touchpad-toggle.lock}"
notifier="${MYUNIX_NOTIFY_SEND:-notify-send}"

mkdir -p "$(dirname "$lock_file")"
exec {lock_fd}>"$lock_file"
# Niri binds repeat by default. Ignore an overlapping invocation so a held key
# or a quick double press cannot race while replacing the state fragment.
flock -n "$lock_fd" || exit 0

write_state() {
  local mode=$1 directory temporary
  directory="$(dirname "$state_file")"
  mkdir -p "$directory"
  temporary="$(mktemp "$directory/.touchpad.kdl.XXXXXX")"

  if [[ "$mode" == disabled ]]; then
    printf '%s\n' \
      'input {' \
      '    touchpad {' \
      '        off' \
      '    }' \
      '}' > "$temporary"
  else
    printf '%s\n' \
      'input {' \
      '    touchpad {' \
      '        tap' \
      '        natural-scroll' \
      '    }' \
      '}' > "$temporary"
  fi

  mv -f "$temporary" "$state_file"
}

if grep -qE '^[[:space:]]*off[[:space:]]*$' "$state_file" 2>/dev/null; then
  write_state enabled
  message='Touchpad enabled'
else
  write_state disabled
  message='Touchpad disabled'
fi

if [[ "${MYUNIX_NIRI_TOUCHPAD_SKIP_RELOAD:-0}" != 1 ]] && command -v niri >/dev/null 2>&1; then
  niri msg action load-config-file >/dev/null 2>&1 || true
fi

if command -v "$notifier" >/dev/null 2>&1; then
  "$notifier" 'Touchpad' "$message" || true
fi

printf '%s\n' "$message"
