#!/usr/bin/env bash
set -Eeuo pipefail

readonly SUPER_BULLET_PROFILE="super-bullet"

usage() {
  cat <<'USAGE'
Usage:
super-bullet run [codex options/prompt...]
  super-bullet exec <prompt...>
  super-bullet review

Commands:
  run       Start an interactive Luna session with the SuperBullet profile.
  exec      Run a noninteractive Luna task, then run a read-only Sol review.
  review    Run only the read-only Sol review of uncommitted changes.
USAGE
}

codex_command() {
  if [[ -n "${MYUNIX_CODEX_BIN:-}" ]]; then
    printf '%s\n' "$MYUNIX_CODEX_BIN"
    return 0
  fi
  command -v codex || {
    printf 'ERROR: codex was not found in PATH.\n' >&2
    return 127
  }
}

review_effort() {
  local effort="${MYUNIX_SUPER_BULLET_REVIEW_EFFORT:-high}"
  case "$effort" in
    high|max) printf '%s\n' "$effort" ;;
    *)
      printf 'ERROR: MYUNIX_SUPER_BULLET_REVIEW_EFFORT must be high or max.\n' >&2
      return 2
      ;;
  esac
}

run_luna() {
  local codex
  codex="$(codex_command)"
  printf 'SuperBullet: active — Luna execution\n'
  "$codex" exec -p "$SUPER_BULLET_PROFILE" "$@"
}

run_interactive() {
  local codex
  codex="$(codex_command)"
  printf 'SuperBullet: active — Luna execution\n'
  exec "$codex" -p "$SUPER_BULLET_PROFILE" "$@"
}

git_repository_root() {
  git rev-parse --show-toplevel 2>/dev/null || true
}

git_head() {
  git rev-parse HEAD 2>/dev/null || true
}

git_worktree_changed() {
  ! git diff --quiet 2>/dev/null ||
    ! git diff --cached --quiet 2>/dev/null ||
    [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]]
}

run_sol_review() {
  local target=${1:-uncommitted} base_commit=${2:-} codex effort
  codex="$(codex_command)"
  effort="$(review_effort)"
  if [[ "$target" == base ]]; then
    [[ -n "$base_commit" ]] || {
      printf 'ERROR: a base commit is required for exact review.\n' >&2
      return 2
    }
    printf 'SuperBullet: active — Sol validation\n'
    "$codex" review \
      -c 'model="gpt-5.6-sol"' \
      -c "model_reasoning_effort=\"$effort\"" \
      --disable multi_agent \
      --base "$base_commit"
    return
  fi
  printf 'SuperBullet: active — Sol validation\n'
  "$codex" review \
    -c 'model="gpt-5.6-sol"' \
    -c "model_reasoning_effort=\"$effort\"" \
    --disable multi_agent \
    --uncommitted
}

run_noninteractive() {
  local status prompt repository before_head after_head
  prompt="$*"
  [[ -n "$prompt" ]] || {
    printf 'ERROR: super-bullet exec requires a prompt.\n' >&2
    return 2
  }
  repository="$(git_repository_root)"
  before_head="$(git_head)"
  run_luna "$prompt" || {
    status=$?
    printf 'SuperBullet: Sol validation skipped because Luna execution failed (status %s).\n' "$status" >&2
    return "$status"
  }
  if [[ -n "$repository" && -n "$before_head" ]]; then
    after_head="$(git_head)"
    if [[ "$after_head" != "$before_head" ]]; then
      run_sol_review base "$before_head"
    elif git_worktree_changed; then
      run_sol_review uncommitted
    else
      printf 'SuperBullet: Sol validation skipped because Luna produced no repository changes.\n'
    fi
  else
    printf 'SuperBullet: Sol validation skipped because the working directory is not a Git repository.\n'
  fi
}

main() {
  local command_name="${1:-}"
  if [[ -z "$command_name" || "$command_name" == --help || "$command_name" == -h ]]; then
    usage
    return 0
  fi
  shift
  case "$command_name" in
    run) run_interactive "$@" ;;
    exec) run_noninteractive "$@" ;;
    review)
      [[ $# -eq 0 ]] || {
        printf 'ERROR: super-bullet review does not accept a prompt with this Codex CLI; use the global review policy.\n' >&2
        return 2
      }
      run_sol_review uncommitted
      ;;
    *)
      printf 'ERROR: unknown command: %s\n\n' "$command_name" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
