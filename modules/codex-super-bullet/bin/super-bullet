#!/usr/bin/env bash
set -Eeuo pipefail

readonly SUPER_BULLET_PROFILE="super-bullet"

usage() {
  cat <<'USAGE'
Usage:
super-bullet run [temporary override flags] [codex options/prompt...]
  super-bullet exec [temporary override flags] <prompt...>
  super-bullet review [temporary override flags]
  super-bullet config show|set|reset ...

Temporary override flags:
  --luna-model MODEL       --luna-effort EFFORT
  --sol-model MODEL        --sol-effort EFFORT

Config commands persist user-level defaults in
${CODEX_HOME:-$HOME/.codex}/super-bullet.runtime.toml.
USAGE
}

codex_command() {
  if [[ -n "${MYUNIX_CODEX_BIN:-}" ]]; then
    printf '%s\n' "$MYUNIX_CODEX_BIN"
    return 0
  fi
  command -v codex || { printf 'ERROR: codex was not found in PATH.\n' >&2; return 127; }
}

runtime_config_file() { printf '%s\n' "${MYUNIX_CODEX_HOME:-${CODEX_HOME:-$HOME/.codex}}/super-bullet.runtime.toml"; }
runtime_default() {
  case "$1" in
    luna_model) printf '%s\n' 'gpt-5.6-luna' ;;
    luna_reasoning_effort) printf '%s\n' 'max' ;;
    sol_model) printf '%s\n' 'gpt-5.6-sol' ;;
    sol_reasoning_effort) printf '%s\n' 'high' ;;
    *) return 1 ;;
  esac
}
runtime_file_value() {
  local key=$1 file
  file="$(runtime_config_file)"
  [[ -r "$file" ]] || return 1
  awk -v key="$key" '$0 ~ "^[[:space:]]*" key "[[:space:]]*=" { value=$0; sub(/^[^=]*=[[:space:]]*/,"",value); sub(/[[:space:]]*#.*/,"",value); gsub(/^"|"$/, "", value); print value; found=1; exit } END { if (!found) exit 1 }' "$file"
}
effective_runtime_value() {
  local key=$1 value=''
  case "$key" in
    luna_model) value="${MYUNIX_SUPER_BULLET_LUNA_MODEL:-}" ;;
    luna_reasoning_effort) value="${MYUNIX_SUPER_BULLET_LUNA_EFFORT:-}" ;;
    sol_model) value="${MYUNIX_SUPER_BULLET_SOL_MODEL:-}" ;;
    sol_reasoning_effort) value="${MYUNIX_SUPER_BULLET_SOL_EFFORT:-${MYUNIX_SUPER_BULLET_REVIEW_EFFORT:-}}" ;;
    *) return 1 ;;
  esac
  [[ -n "$value" ]] || value="$(runtime_file_value "$key" 2>/dev/null || runtime_default "$key")"
  case "$key" in
    luna_model|sol_model) validate_model "$value" || return $? ;;
    luna_reasoning_effort|sol_reasoning_effort) validate_effort "$value" || return $? ;;
  esac
  printf '%s\n' "$value"
}
validate_model() { [[ "$1" =~ ^[[:alnum:]_.:/-]+$ ]] || { printf 'ERROR: invalid model name: %s\n' "$1" >&2; return 2; }; }
validate_effort() {
  case "$1" in low|medium|high|xhigh|max) ;; *) printf 'ERROR: reasoning effort must be low, medium, high, xhigh, or max: %s\n' "$1" >&2; return 2 ;; esac
}
canonical_key() {
  case "$1" in
    luna-model|luna_model) printf '%s\n' luna_model ;;
    luna-effort|luna-reasoning-effort|luna_reasoning_effort) printf '%s\n' luna_reasoning_effort ;;
    sol-model|sol_model) printf '%s\n' sol_model ;;
    sol-effort|sol-reasoning-effort|sol_reasoning_effort) printf '%s\n' sol_reasoning_effort ;;
    *) printf 'ERROR: unknown SuperBullet setting: %s\n' "$1" >&2; return 2 ;;
  esac
}
write_runtime_config() {
  local file temporary backup luna_model=$1 luna_effort=$2 sol_model=$3 sol_effort=$4
  file="$(runtime_config_file)"; mkdir -p "$(dirname "$file")"
  if [[ -f "$file" ]]; then backup="${XDG_STATE_HOME:-$HOME/.local/state}/myunix/backups/codex-super-bullet/$(date +%Y%m%d-%H%M%S)/super-bullet.runtime.toml"; mkdir -p "$(dirname "$backup")"; cp -a "$file" "$backup"; fi
  temporary="$(mktemp "${file}.myunix.XXXXXX")"
  printf '%s\n' '# Managed by MyUnix SuperBullet; not read by Codex directly.' "luna_model = \"$luna_model\"" "luna_reasoning_effort = \"$luna_effort\"" "sol_model = \"$sol_model\"" "sol_reasoning_effort = \"$sol_effort\"" > "$temporary"
  chmod 0600 "$temporary"; mv "$temporary" "$file"
}
config_command() {
  local action=${1:-show} key value; shift || true
  case "$action" in
    show)
      [[ $# -eq 0 ]] || { printf '%s\n' 'Usage: super-bullet config show' >&2; return 2; }
      local luna_model luna_effort sol_model sol_effort
      luna_model="$(effective_runtime_value luna_model)" || return $?
      luna_effort="$(effective_runtime_value luna_reasoning_effort)" || return $?
      sol_model="$(effective_runtime_value sol_model)" || return $?
      sol_effort="$(effective_runtime_value sol_reasoning_effort)" || return $?
      printf 'file=%s\nluna_model=%s\nluna_reasoning_effort=%s\nsol_model=%s\nsol_reasoning_effort=%s\n' "$(runtime_config_file)" "$luna_model" "$luna_effort" "$sol_model" "$sol_effort"
      ;;
    set)
      [[ $# -eq 2 ]] || { printf '%s\n' 'Usage: super-bullet config set <setting> <value>' >&2; return 2; }
      key="$(canonical_key "$1")" || return $?; value=$2
      case "$key" in luna_model|sol_model) validate_model "$value" || return $? ;; *) validate_effort "$value" || return $? ;; esac
      local luna_model luna_effort sol_model sol_effort
      luna_model="$(runtime_file_value luna_model 2>/dev/null || runtime_default luna_model)"; luna_effort="$(runtime_file_value luna_reasoning_effort 2>/dev/null || runtime_default luna_reasoning_effort)"; sol_model="$(runtime_file_value sol_model 2>/dev/null || runtime_default sol_model)"; sol_effort="$(runtime_file_value sol_reasoning_effort 2>/dev/null || runtime_default sol_reasoning_effort)"
      case "$key" in luna_model) luna_model=$value ;; luna_reasoning_effort) luna_effort=$value ;; sol_model) sol_model=$value ;; sol_reasoning_effort) sol_effort=$value ;; esac
      write_runtime_config "$luna_model" "$luna_effort" "$sol_model" "$sol_effort"; printf 'Updated %s=%s in %s\n' "$key" "$value" "$(runtime_config_file)"
      ;;
    reset)
      [[ $# -le 1 ]] || { printf '%s\n' 'Usage: super-bullet config reset [setting]' >&2; return 2; }
      if [[ $# -eq 0 ]]; then rm -f "$(runtime_config_file)"; printf '%s\n' 'Reset SuperBullet settings to launcher defaults.'; return 0; fi
      key="$(canonical_key "$1")" || return $?
      value="$(runtime_default "$key")"
      config_command set "$key" "$value"
      ;;
    *) printf 'ERROR: unknown config action: %s\n' "$action" >&2; return 2 ;;
  esac
}
parse_runtime_options() {
  SUPER_BULLET_LUNA_MODEL_OVERRIDE=''; SUPER_BULLET_LUNA_EFFORT_OVERRIDE=''; SUPER_BULLET_SOL_MODEL_OVERRIDE=''; SUPER_BULLET_SOL_EFFORT_OVERRIDE=''; SUPER_BULLET_REMAINING_ARGS=()
  while (($#)); do
    case "$1" in
      --luna-model) [[ $# -ge 2 ]] || { printf '%s\n' 'ERROR: --luna-model requires a value' >&2; return 2; }; SUPER_BULLET_LUNA_MODEL_OVERRIDE=$2; shift 2 ;;
      --luna-effort|--luna-reasoning-effort) [[ $# -ge 2 ]] || { printf '%s\n' "ERROR: $1 requires a value" >&2; return 2; }; SUPER_BULLET_LUNA_EFFORT_OVERRIDE=$2; shift 2 ;;
      --sol-model) [[ $# -ge 2 ]] || { printf '%s\n' 'ERROR: --sol-model requires a value' >&2; return 2; }; SUPER_BULLET_SOL_MODEL_OVERRIDE=$2; shift 2 ;;
      --sol-effort|--sol-reasoning-effort) [[ $# -ge 2 ]] || { printf '%s\n' "ERROR: $1 requires a value" >&2; return 2; }; SUPER_BULLET_SOL_EFFORT_OVERRIDE=$2; shift 2 ;;
      --) shift; SUPER_BULLET_REMAINING_ARGS+=("$@"); break ;;
      *) SUPER_BULLET_REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
  if [[ -n "$SUPER_BULLET_LUNA_MODEL_OVERRIDE" ]]; then
    validate_model "$SUPER_BULLET_LUNA_MODEL_OVERRIDE" || return $?
  fi
  if [[ -n "$SUPER_BULLET_SOL_MODEL_OVERRIDE" ]]; then
    validate_model "$SUPER_BULLET_SOL_MODEL_OVERRIDE" || return $?
  fi
  if [[ -n "$SUPER_BULLET_LUNA_EFFORT_OVERRIDE" ]]; then
    validate_effort "$SUPER_BULLET_LUNA_EFFORT_OVERRIDE" || return $?
  fi
  if [[ -n "$SUPER_BULLET_SOL_EFFORT_OVERRIDE" ]]; then
    validate_effort "$SUPER_BULLET_SOL_EFFORT_OVERRIDE" || return $?
  fi
  luna_model >/dev/null || return $?
  luna_effort >/dev/null || return $?
  sol_model >/dev/null || return $?
  sol_effort >/dev/null || return $?
}
luna_model() {
  local value="${SUPER_BULLET_LUNA_MODEL_OVERRIDE:-${MYUNIX_SUPER_BULLET_LUNA_MODEL:-}}"
  [[ -n "$value" ]] || value="$(effective_runtime_value luna_model)"
  validate_model "$value" || return $?
  printf '%s\n' "$value"
}
luna_effort() {
  local value="${SUPER_BULLET_LUNA_EFFORT_OVERRIDE:-${MYUNIX_SUPER_BULLET_LUNA_EFFORT:-}}"
  [[ -n "$value" ]] || value="$(effective_runtime_value luna_reasoning_effort)"
  validate_effort "$value" || return $?
  printf '%s\n' "$value"
}
sol_model() {
  local value="${SUPER_BULLET_SOL_MODEL_OVERRIDE:-${MYUNIX_SUPER_BULLET_SOL_MODEL:-}}"
  [[ -n "$value" ]] || value="$(effective_runtime_value sol_model)"
  validate_model "$value" || return $?
  printf '%s\n' "$value"
}
sol_effort() {
  local value="${SUPER_BULLET_SOL_EFFORT_OVERRIDE:-${MYUNIX_SUPER_BULLET_SOL_EFFORT:-${MYUNIX_SUPER_BULLET_REVIEW_EFFORT:-}}}"
  [[ -n "$value" ]] || value="$(effective_runtime_value sol_reasoning_effort)"
  validate_effort "$value" || return $?
  printf '%s\n' "$value"
}
codex_model_options() {
  CODEX_MODEL_OPTIONS=()
  [[ "$1" == "$3" ]] || CODEX_MODEL_OPTIONS+=( -c "model=\"$1\"" )
  [[ "$2" == "$4" ]] || CODEX_MODEL_OPTIONS+=( -c "model_reasoning_effort=\"$2\"" )
}
run_luna() {
  local codex model effort
  codex="$(codex_command)" || return $?
  model="$(luna_model)" || return $?
  effort="$(luna_effort)" || return $?
  codex_model_options "$model" "$effort" 'gpt-5.6-luna' 'max'
  printf 'SuperBullet: active — Luna execution\n'
  "$codex" exec -p "$SUPER_BULLET_PROFILE" "${CODEX_MODEL_OPTIONS[@]}" "$@"
}
run_interactive() {
  local codex model effort
  codex="$(codex_command)" || return $?
  model="$(luna_model)" || return $?
  effort="$(luna_effort)" || return $?
  codex_model_options "$model" "$effort" 'gpt-5.6-luna' 'max'
  printf 'SuperBullet: active — Luna execution\n'
  exec "$codex" -p "$SUPER_BULLET_PROFILE" "${CODEX_MODEL_OPTIONS[@]}" "$@"
}
git_repository_root() { git rev-parse --show-toplevel 2>/dev/null || true; }
git_head() { git rev-parse HEAD 2>/dev/null || true; }
git_worktree_changed() { ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null || [[ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]]; }
run_sol_review() {
  local target=${1:-uncommitted} base_commit=${2:-} codex model effort
  codex="$(codex_command)" || return $?
  model="$(sol_model)" || return $?
  effort="$(sol_effort)" || return $?
  CODEX_MODEL_OPTIONS=( -c "model=\"$model\"" -c "model_reasoning_effort=\"$effort\"" )
  if [[ "$target" == base ]]; then
    [[ -n "$base_commit" ]] || { printf '%s\n' 'ERROR: a base commit is required for exact review.' >&2; return 2; }
    printf 'SuperBullet: active — Sol validation\n'
    "$codex" review "${CODEX_MODEL_OPTIONS[@]}" --disable multi_agent --base "$base_commit"
    return
  fi
  printf 'SuperBullet: active — Sol validation\n'
  "$codex" review "${CODEX_MODEL_OPTIONS[@]}" --disable multi_agent --uncommitted
}
run_noninteractive() { local status prompt repository before_head after_head; prompt="$*"; [[ -n "$prompt" ]] || { printf 'ERROR: super-bullet exec requires a prompt.\n' >&2; return 2; }; repository="$(git_repository_root)"; before_head="$(git_head)"; run_luna "$prompt" || { status=$?; printf 'SuperBullet: Sol validation skipped because Luna execution failed (status %s).\n' "$status" >&2; return "$status"; }; if [[ -n "$repository" && -n "$before_head" ]]; then after_head="$(git_head)"; if [[ "$after_head" != "$before_head" ]]; then run_sol_review base "$before_head"; elif git_worktree_changed; then run_sol_review uncommitted; else printf '%s\n' 'SuperBullet: Sol validation skipped because Luna produced no repository changes.'; fi; else printf '%s\n' 'SuperBullet: Sol validation skipped because the working directory is not a Git repository.'; fi; }
main() {
  local command_name="${1:-}"; if [[ -z "$command_name" || "$command_name" == --help || "$command_name" == -h ]]; then usage; return 0; fi; shift
  case "$command_name" in
    run) parse_runtime_options "$@" || return $?; run_interactive "${SUPER_BULLET_REMAINING_ARGS[@]}" ;;
    exec) parse_runtime_options "$@" || return $?; run_noninteractive "${SUPER_BULLET_REMAINING_ARGS[*]}" ;;
    config) config_command "$@" ;;
    review) parse_runtime_options "$@" || return $?; [[ ${#SUPER_BULLET_REMAINING_ARGS[@]} -eq 0 ]] || { printf '%s\n' 'ERROR: review accepts only temporary override flags.' >&2; return 2; }; run_sol_review uncommitted ;;
    *) printf 'ERROR: unknown command: %s\n\n' "$command_name" >&2; usage >&2; return 2 ;;
  esac
}
main "$@"
